---
import Base from '../../layouts/Base.astro';
import PubRow from '../../components/PubRow.astro';
import TypeTags from '../../components/TypeTags.astro';
import { projects } from '../../data/projects';
import { chips } from '../../data/chips';
import { patents } from '../../data/resume';
import { pubsByIds } from '../../data/util';
import type { Spec } from '../../data/types';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}
const { project: p } = Astro.props;

const chip = p.chipId ? chips.find((c) => c.id === p.chipId) : null;
const pubs = pubsByIds(p.pubIds);
const pats = (p.patentIds ?? []).map((id) => patents.find((pt) => pt.id === id)).filter(Boolean);
const kpis = p.metrics ?? chip?.kpis ?? [];

const specs = chip?.specs ?? [];
const specRows: Spec[][] = [];
for (let i = 0; i < specs.length; i += 2) specRows.push(specs.slice(i, i + 2));
---
<Base title={`${p.codename} — Sukbin Lim`} description={p.narrative}>
  <a class="back" href="/projects">← All projects</a>

  <article class="detail">
    <div class="dhead">
      <span class={`role acc-${p.accent}`}>{p.role}</span>
      <span class="flag-top-r">
        <TypeTags tags={p.tags} />
        <span class="nodebadge">{p.node}</span>
      </span>
    </div>
    <h1>{p.codename}</h1>
    <div class="dsub">{p.kind} · {p.org}</div>

    {kpis.length > 0 && (
      <div class="kpis big">
        {kpis.map((k) => (
          <div class={k.hot ? 'kpi hot' : 'kpi'}>
            <div class="v">{k.value}</div>
            <div class="k">{k.label}</div>
          </div>
        ))}
      </div>
    )}

    <p class="dnarr">{p.narrative}</p>

    {specRows.length > 0 && (
      <section class="dblock">
        <h2 class="dh">Silicon</h2>
        <div class="ds">
          {specRows.map((row) => (
            <div class="dr">
              {row.map((s) => (
                <div class="cell">
                  <span class="k">{s.label}</span>
                  <span class={s.hot ? 'v b' : 'v'}>{s.value}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    {pubs.length > 0 && (
      <section class="dblock">
        <h2 class="dh">Publications</h2>
        {pubs.map((pub) => <PubRow pub={pub} />)}
      </section>
    )}

    {pats.length > 0 && (
      <section class="dblock">
        <h2 class="dh">Patents</h2>
        <ul class="patlist">
          {pats.map((pt) => <li><span class="ptid">{pt!.id}</span> {pt!.title}</li>)}
        </ul>
      </section>
    )}
  </article>
</Base>
