---
import type { Project } from '../data/types';
import { venueTags } from '../data/util';
import TypeTags from './TypeTags.astro';
interface Props { project: Project }
const { project: p } = Astro.props;
const tags = venueTags(p.pubIds);
---
<a class={`flag acc-${p.accent}`} href={`/projects/${p.id}`}>
  <div class="flag-top">
    <span class={`role acc-${p.accent}`}>{p.role}</span>
    <span class="flag-top-r">
      <TypeTags tags={p.tags} />
      <span class="nodebadge">{p.node}</span>
    </span>
  </div>
  <h3>{p.codename}</h3>
  <div class="sub">{p.kind}</div>

  <div class="kpis">
    {(p.metrics ?? []).map((k) => (
      <div class={k.hot ? 'kpi hot' : 'kpi'}>
        <div class="v">{k.value}</div>
        <div class="k">{k.label}</div>
      </div>
    ))}
  </div>

  <p class="d">{p.narrative}</p>

  <div class="flag-foot">
    <span class="vtags">{tags.map((t) => <span class="vtag">{t}</span>)}</span>
    <span class="go">View project →</span>
  </div>
</a>
